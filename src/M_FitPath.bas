Attribute VB_Name = "M_FitPath"
Option Explicit

'==========================================================
' ?????????????v1 ??????????
'
' ????????? 1 ????????????????+ 2 ??????
'       ???????????????????????????????
'
' ?????CorelDRAW X4 ????????????????? API??
'       ????????????????????????????????????????
'       ????????????????????????
'==========================================================

Public Sub FitObjectsToPath()
    Dim sr As ShapeRange
    Dim i As Long
    Dim cntPath As Long
    Dim pathShape As Shape
    Dim a As Shape
    Dim b As Shape
    Dim eff As Object

    If Not HasDocument() Then Exit Sub

    Set sr = CorelDRAW.ActiveSelection
    If sr.Count < 3 Then
        MsgBox "????? 1 ?????????? + ???? 2 ??????", vbExclamation, "???????????"
        Exit Sub
    End If

    ' ??????????????????????
    For i = 1 To sr.Count
        If sr(i).Type = cdrCurveShape Then
            cntPath = cntPath + 1
            If cntPath = 1 Then Set pathShape = sr(i)
        End If
    Next i

    If cntPath <> 1 Then
        MsgBox "?????????????????? 1 ????????????????????? " & cntPath & " ??????", _
               vbExclamation, "???????????"
        Exit Sub
    End If

    ' ???????????????
    For i = 1 To sr.Count
        If Not sr(i) Is pathShape Then
            If a Is Nothing Then
                Set a = sr(i)
            ElseIf b Is Nothing Then
                Set b = sr(i)
            End If
        End If
    Next i

    If a Is Nothing Or b Is Nothing Then
        MsgBox "??????? 2 ????????????", vbExclamation, "???????????"
        Exit Sub
    End If

    Set eff = Nothing
    On Error Resume Next
    Set eff = a.CreateBlend(b)
    If Not eff Is Nothing Then eff.Blend.Path = pathShape
    On Error GoTo 0

    If eff Is Nothing Then
        MsgBox "????????????????????????????????", vbExclamation, "???????????"
        Exit Sub
    End If

    DoRefresh
End Sub